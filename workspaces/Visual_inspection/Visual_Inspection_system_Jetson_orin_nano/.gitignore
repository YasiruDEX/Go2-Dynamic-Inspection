# ============================================================
# .gitignore — Visual Inspection System (Jetson Orin Nano)
# ============================================================

# ── Python virtual environments ──────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
.Python
*.egg-info/
dist/
build/
*.egg

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Large archives (GitHub 100MB limit) ───────────────────────
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip

# ── TensorRT engine files (device-specific, cannot share) ─────
*.engine
*.trt

# ── CUDA installer debs (downloaded during setup) ─────────────
cuda-keyring*.deb

# ── Nested git repo (separate go2 drone project) ──────────────
Codebase/

# ── Log files ─────────────────────────────────────────────────
logs/
*.log

# ── Markdown docs (only README.md files are kept) ─────────────
*.md
!README.md
!**/README.md

# ── OS / IDE files ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# ── Temporary / test output images ────────────────────────────
test_insta360.jpg
test_logitech.jpg
camera_test__dev_video1.jpg

# ── Gemini AI workspace (internal tool files) ─────────────────
.gemini/
