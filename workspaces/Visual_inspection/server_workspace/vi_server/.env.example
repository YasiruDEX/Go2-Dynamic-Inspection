# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/vi_server.db

# Storage Configuration
STORAGE_ROOT=./data/jobs
MAX_UPLOAD_SIZE_MB=10

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Allowed Object Types (comma-separated)
ALLOWED_OBJECT_TYPES=gauge,door,fire_extinguisher,unknown,emergency_exit,main_cylinder

# Job Processing
MAX_QUEUE_SIZE=1000
WORKER_POLL_INTERVAL=0.1

# VLM Configuration
# Provider: "stub" (offline testing) or "openai" (requires API key)
VLM_PROVIDER=stub
VLM_API_KEY=
# Model for OpenAI (e.g., gpt-4o, gpt-4-vision-preview)
VLM_MODEL=gpt-4o
