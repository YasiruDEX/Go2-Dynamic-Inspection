#HOST PC BASHRC

start_robot() {
  # Define the workspace path to keep things readable
  local CLOUD_WS="/home/yasiru/Documents/Far_planner_test/workspaces/cloudini/install/setup.bash"
  local ROS_BASE="/opt/ros/humble/setup.bash"
  
  # Base command to source everything - we will prepend this to every pane
  local INIT="source $ROS_BASE && source $CLOUD_WS"

  # 1. CREATE THE SESSION FIRST (This fixes the /tmp/tmux error!)
  tmux new-session -d -s robot

  # Run the Converter in the first pane
  tmux send-keys -t robot "$INIT && ros2 run cloudini_ros cloudini_topic_converter --ros-args -p compressing:=false -p topic_input:=/out/cloudini -p topic_output:=/points_raw_decoded" C-m

  # 2. Split for the Zenoh Bridge
  tmux split-window -h -t robot
  tmux send-keys -t robot "$INIT && zenoh-bridge-ros2dds -e tcp/192.168.8.181:7447" C-m

  # 3. Clean up layout and attach (Fixed the missing space typo here)
  tmux select-layout -t robot tiled
  tmux attach -t robot
}


