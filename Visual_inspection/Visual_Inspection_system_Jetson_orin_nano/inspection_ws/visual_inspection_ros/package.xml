<?xml version="1.0"?>
<package format="3">
  <name>visual_inspection_ros</name>
  <version>0.1.0</version>
  <description>
    Visual inspection ROS2 nodes — IBVS pipeline as Action Server.
    BehaviorTree.CPP calls /visual_inspection/inspect_objects action.
  </description>
  <maintainer email="dinethra@example.com">Dinethra</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>visual_inspection_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
